# FunPay — токен доступа к аккаунту. НЕ отправляйте его в чат и не добавляйте в Git.
FUNPAY_GOLDEN_KEY=
# Желательно указать User-Agent браузера, в котором открыт ваш FunPay.
FUNPAY_USER_AGENT=
FUNPAY_REQUESTS_DELAY=8

# На первом запуске оставьте true: бот увидит продажи и сохранит их,
# но НЕ будет отправлять сообщения. После проверки входа поменяйте на false.
FUNPAY_DRY_RUN=true
FUNPAY_FIRST_START_BASELINE=true

# База на постоянном диске хостинга:
DATABASE_PATH=/app/data/bot.db

# Vexboost пока не задействован на этом этапе.
VEXBOOST_BASE_URL=https://vexboost.ru/api/v2
VEXBOOST_API_KEY=
VEXBOOST_TIMEOUT_SECONDS=20
